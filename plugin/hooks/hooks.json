{
  "hooks": {
    "PermissionRequest": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "beckon", "args": ["hook", "PermissionRequest"], "timeout": 3600 }] }],
    "PostToolUse": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "beckon", "args": ["hook", "PostToolUse"], "timeout": 5 }] }],
    "PostToolUseFailure": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "beckon", "args": ["hook", "PostToolUseFailure"], "timeout": 5 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "beckon", "args": ["hook", "UserPromptSubmit"], "timeout": 5 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "beckon", "args": ["hook", "Stop", "--rewake"], "timeout": 3600, "asyncRewake": true }] }],
    "StopFailure": [{ "hooks": [{ "type": "command", "command": "beckon", "args": ["hook", "StopFailure"], "timeout": 5 }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "beckon", "args": ["hook", "SubagentStop"], "timeout": 5 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "beckon", "args": ["hook", "SessionEnd"], "timeout": 5 }] }]
  }
}
